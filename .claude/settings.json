{
  "permissions": {
    "allow": [
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:doc.evolution-api.com)",
      "WebFetch(domain:docs.evolution-api.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:www.postman.com)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration",
      "mcp__supabase__list_tables",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__deploy_edge_function",
      "Bash(npx trigger.dev*)",
      "Bash(npx trigger.dev@latest deploy --skip-typecheck)",
      "Bash(curl -s --connect-timeout *)",
      "Bash(claude --version)",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_migrations",
      "mcp__claude_ai_Supabase__get_logs",
      "mcp__claude_ai_Supabase__get_publishable_keys",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_MCP_GITHUB__create_pull_request",
      "mcp__claude_ai_MCP_GITHUB__merge_pull_request",
      "mcp__claude_ai_MCP_GITHUB__push_files",
      "mcp__claude_ai_MCP_GITHUB__get_file_contents",
      "mcp__claude_ai_MCP_GITHUB__list_pull_requests",
      "mcp__claude_ai_MCP_GITHUB__pull_request_read",
      "Bash(node --check *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git push origin *)",
      "Bash(git merge origin/main)",
      "Bash(git branch*)",
      "Bash(git worktree *)",
      "Bash(git show*)",
      "Bash(pm2 list)",
      "Bash(pm2 status*)",
      "Bash(pm2 logs*)",
      "Bash(pm2 describe *)",
      "Bash(pm2 restart bridge-server)",
      "Bash(pm2 restart bridge*)",
      "Bash(pm2 reload bridge*)"
    ],
    "defaultMode": "acceptEdits",
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ecc-pipeline-context.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck.cjs\"",
            "timeout": 35
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/eslint-jsx.cjs\"",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-stop.cjs\"",
            "timeout": 60,
            "statusMessage": "Verificando TypeScript antes de concluir..."
          }
        ]
      }
    ]
  },
  "env": {
    "ECC_HOOK_PROFILE": "minimal"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    }
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "ecc@ecc": true
  },
  "autoCompactEnabled": true,
  "worktree": {
    "bgIsolation": "none"
  }
}
